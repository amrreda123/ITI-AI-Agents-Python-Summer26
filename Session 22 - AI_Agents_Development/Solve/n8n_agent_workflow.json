{
  "name": "ITI AI Agent Support Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agent-support",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "agent-support"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.message }}",
        "options": {
          "systemMessage": "You are a customer-support operations agent. Use connected tools for live customer or order data. Never invent balances, order status, or contact details. Do not send external messages unless the workflow explicitly allows it. Keep answers concise and factual."
        }
      },
      "id": "2",
      "name": "AI Agent Node",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [440, 300]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "3",
      "name": "Google Gemini Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [360, 520],
      "credentials": {
        "googlePalmApi": {
          "id": "gemini-api-cred",
          "name": "Gemini API Account"
        }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $json.body.ticket_id }}"
      },
      "id": "4",
      "name": "Window Buffer Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [520, 520]
    },
    {
      "parameters": {
        "name": "google_sheets_lookup",
        "description": "Look up live customer order status and financial balance using customer_id or order_id.",
        "workflowId": "mock-sheet-lookup"
      },
      "id": "5",
      "name": "Sheets Lookup Tool",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 1.1,
      "position": [680, 520]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"ticket_id\": \"{{ $('Webhook Trigger').item.json.body.ticket_id }}\",\n  \"status\": \"processed\",\n  \"message\": \"{{ $json.output }}\"\n}",
        "options": {}
      },
      "id": "6",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [780, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "AI Agent Node",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Gemini Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent Node",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Window Buffer Memory": {
      "ai_memory": [
        [
          {
            "node": "AI Agent Node",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "Sheets Lookup Tool": {
      "ai_tool": [
        [
          {
            "node": "AI Agent Node",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent Node": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
